---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getAchievements, getProjects, projectHref, type Project } from '../lib/data';
import { fmtAchDate, fmtDate, loc, localizePath, useT, type Lang } from '../i18n';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const lang: Lang = Astro.currentLocale === 'en' ? 'en' : 'ru';
const t = useT(lang);
const d = project.data;
const all = await getProjects();
const idx = all.findIndex((p) => p.id === project.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : null;
const related = (await getAchievements()).filter((a) => d.achievements.includes(a.id) || a.data.project === project.id);
const home = localizePath('/', lang);

/** Plain text with blank-line paragraphs and "- " bullet lists. */
function blocks(text: string) {
  return text
    .split(/\n\s*\n/)
    .map((b) => b.trim())
    .filter(Boolean)
    .map((b) => {
      const lines = b.split('\n').map((l) => l.trim());
      return lines.every((l) => /^[-•]\s+/.test(l)) ? { list: lines.map((l) => l.replace(/^[-•]\s+/, '')) } : { p: lines.join(' ') };
    });
}
const sections = [
  { n: '01', label: t('project.problem'), body: blocks(loc(d.problem, lang)) },
  { n: '02', label: t('project.did'), body: blocks(loc(d.did, lang)) },
  { n: '03', label: t('project.outcome'), body: blocks(loc(d.outcome, lang)) },
].filter((s) => s.body.length);

const facts = [
  { k: t('project.event'), v: loc(d.event, lang) },
  { k: lang === 'ru' ? 'Когда' : 'When', v: loc(d.period, lang) || fmtDate(d.date, lang) },
  { k: t('project.status'), v: loc(d.status, lang) },
  { k: t('project.team'), v: loc(d.team, lang) },
].filter((f) => f.v);

const gallery = await Promise.all(
  d.gallery.map(async (g) => {
    const [big, thumb] = await Promise.all([getImage({ src: g.src, width: 1800, format: 'webp' }), getImage({ src: g.src, width: 760, format: 'webp' })]);
    return { g, big, thumb };
  }),
);
const linkIcon: Record<string, string> = {
  github: 'M12 2.5a9.7 9.7 0 0 0-3.1 18.9c.5.1.7-.2.7-.5v-1.8c-2.7.6-3.3-1.2-3.3-1.2-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.1-.2-4.4-1.1-4.4-4.8 0-1.1.4-1.9 1-2.6-.1-.2-.4-1.2.1-2.6 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.6.6.7 1 1.5 1 2.6 0 3.7-2.3 4.6-4.4 4.8.3.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.7 9.7 0 0 0 12 2.5Z',
};
const title = `${d.name} — ${loc(d.tagline, lang)} | ${lang === 'ru' ? 'Геннадий Козлов' : 'Gennadiy Kozlov'}`;
---

<Base title={title} description={loc(d.tagline, lang)} ogKey={`project-${project.id}`}>
  <article class="relative overflow-clip">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[70vh]" aria-hidden="true">
      <div class="grid-bg absolute inset-0 opacity-60"></div>
      <div class="glow-blob left-[-10rem] top-[-14rem] h-[40rem] w-[40rem] !opacity-30" style="--c: var(--glow)"></div>
    </div>

    <header class="container-x relative pt-[calc(var(--nav-h)+3rem)]">
      <a href={`${home}#projects`} class="back-link" data-reveal>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M19 12H6m0 0 5.5-5.5M6 12l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        {t('project.back')}
      </a>
      <p class="eyebrow mt-10" data-reveal>{[loc(d.event, lang), fmtDate(d.date, lang)].filter(Boolean).join(' · ')}</p>
      <h1 class="project-title" data-split>{d.name}</h1>
      <p class="mt-6 max-w-3xl text-[clamp(1.15rem,2vw,1.6rem)] leading-snug text-[var(--text-dim)]" data-reveal>{loc(d.tagline, lang)}</p>
      <div class="mt-8 flex flex-wrap gap-2" data-reveal>
        {loc(d.result, lang) && <span class="chip chip-accent">{loc(d.result, lang)}</span>}
        {d.stack.map((s) => <span class="chip">{s}</span>)}
      </div>
    </header>

    {
      d.cover && (
        <div class="container-x relative mt-14">
          <div class="project-cover" transition:name={`cover-${project.id}`}>
            <Image src={d.cover} alt={loc(d.coverAlt, lang)} widths={[800, 1400, 2000]} sizes="(min-width: 1312px) 1232px, 94vw" loading="eager" class="h-full w-full object-cover" />
          </div>
        </div>
      )
    }

    {
      facts.length > 0 && (
        <div class="container-x mt-12">
          <dl class="facts" data-reveal>
            {facts.map((f) => (
              <div class="fact">
                <dt class="eyebrow">{f.k}</dt>
                <dd class="mt-2 text-[0.98rem] text-[var(--text)]">{f.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="container-x mt-20 space-y-16 md:mt-28 md:space-y-24">
      {
        sections.map((s) => (
          <section class="story" aria-label={s.label}>
            <h2 class="story-label" data-reveal>
              <span class="text-[var(--accent)]">{s.n}</span>
              {s.label}
            </h2>
            <div class="story-body" data-reveal style="--d:.08s">
              {s.body.map((b) =>
                'list' in b ? (
                  <ul class="story-list">
                    {b.list!.map((li) => (
                      <li>{li}</li>
                    ))}
                  </ul>
                ) : (
                  <p>{b.p}</p>
                ),
              )}
            </div>
          </section>
        ))
      }

      {
        d.metrics.length > 0 && (
          <dl class="metrics">
            {d.metrics.map((m, i) => (
              <div class="metric" data-reveal style={`--d:${i * 0.07}s`}>
                <dt class="mt-2 text-[0.92rem] text-[var(--text-dim)]">{loc(m.label, lang)}</dt>
                <dd class="metric-value">{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        gallery.length > 0 && (
          <section aria-label={t('project.gallery')}>
            <h2 class="story-label mb-8" data-reveal>{t('project.gallery')}</h2>
            <ul class="gallery" role="list">
              {gallery.map(({ g, big, thumb }, i) => (
                <li data-reveal style={`--d:${(i % 3) * 0.06}s`}>
                  <button
                    type="button"
                    class="gallery-item"
                    data-lb
                    data-lb-group="gallery"
                    data-lb-id={`${project.id}-${i}`}
                    data-lb-src={big.src}
                    data-lb-w={g.src.width}
                    data-lb-h={g.src.height}
                    data-lb-caption={loc(g.caption, lang) || d.name}
                    data-lb-sub={d.name}
                  >
                    <img src={thumb.src} alt={loc(g.caption, lang) || d.name} width={thumb.attributes.width} height={thumb.attributes.height} loading="lazy" decoding="async" />
                    {loc(g.caption, lang) && <span class="gallery-cap">{loc(g.caption, lang)}</span>}
                  </button>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        (d.links.length > 0 || related.length > 0) && (
          <div class="grid gap-12 md:grid-cols-2">
            {d.links.length > 0 && (
              <section aria-label={t('project.links')} data-reveal>
                <h2 class="story-label mb-6">{t('project.links')}</h2>
                <ul class="flex flex-wrap gap-3">
                  {d.links.map((l) => (
                    <li>
                      <a href={l.url} class="btn btn-ghost" target="_blank" rel="noopener" data-magnetic>
                        {linkIcon[l.kind] ? (
                          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={linkIcon[l.kind]} fill="currentColor" /></svg>
                        ) : (
                          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 17 17 7m0 0H8.5M17 7v8.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        )}
                        {loc(l.label, lang)}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
            {related.length > 0 && (
              <section aria-label={t('project.related')} data-reveal>
                <h2 class="story-label mb-6">{t('project.related')}</h2>
                <ul class="space-y-2">
                  {related.map((a) => (
                    <li>
                      <a href={`${home}#a-${a.id}`} class="related">
                        <span class="font-mono text-[0.72rem] text-[var(--text-mute)]">{fmtAchDate(a.data.date, a.data.dateApprox, lang, 'short')}</span>
                        <span class="flex-1">{loc(a.data.title, lang)}</span>
                        {loc(a.data.result, lang) && <span class:list={['chip', a.data.podium && 'chip-accent']}>{loc(a.data.result, lang)}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )
      }
    </div>

    {
      next && (
        <nav class="container-x mt-28" aria-label={t('project.next')}>
          <a href={projectHref(next, lang)} class="next card" data-spot>
            <span class="eyebrow">{t('project.next')}</span>
            <span class="next-name">{next.data.name}</span>
            <span class="text-[var(--text-dim)]">{loc(next.data.tagline, lang)}</span>
            <span class="next-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-dim);
    transition: color 0.25s;
  }
  .back-link:hover {
    color: var(--text);
  }
  .project-title {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.8rem, 9vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .project-cover {
    aspect-ratio: 16 / 8;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  @media (max-width: 640px) {
    .project-cover {
      aspect-ratio: 4 / 3;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .fact {
    padding: 1.3rem 1.2rem 1.3rem 0;
    border-bottom: 1px solid var(--line);
  }
  .story {
    display: grid;
    gap: 1.2rem;
  }
  @media (min-width: 900px) {
    .story {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .story-label {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  @media (min-width: 900px) {
    .story-label {
      position: sticky;
      top: calc(var(--nav-h) + 1.5rem);
      align-self: start;
    }
  }
  .story-body {
    display: grid;
    gap: 1.1rem;
    max-width: 48rem;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--text);
  }
  .story-list {
    display: grid;
    gap: 0.7rem;
  }
  .story-list li {
    position: relative;
    padding-left: 1.6rem;
  }
  .story-list li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.72em;
    width: 0.55rem;
    height: 2px;
    background: var(--accent);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .metric {
    display: flex;
    flex-direction: column-reverse;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
  }
  .metric-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out-expo);
  }
  .gallery-item:hover img {
    transform: scale(1.04);
  }
  .gallery-cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2rem 1rem 0.8rem;
    background: linear-gradient(transparent, rgb(8 9 11 / 0.92));
    font-size: 0.82rem;
    text-align: left;
    color: var(--text-dim);
  }
  .related {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    font-size: 0.92rem;
    transition: border-color 0.25s;
  }
  .related:hover {
    border-color: var(--line-2);
  }
  .next {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.6rem, 4vw, 3rem);
    overflow: hidden;
  }
  .next-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .next-arrow {
    position: absolute;
    right: clamp(1.6rem, 4vw, 3rem);
    top: 50%;
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    margin-top: -1.8rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.5s var(--ease-out-expo);
  }
  .next:hover .next-arrow {
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateX(6px);
  }
</style>
