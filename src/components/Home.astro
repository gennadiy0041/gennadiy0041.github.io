---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Stats from './home/Stats.astro';
import Venues from './home/Venues.astro';
import Projects from './home/Projects.astro';
import Timeline from './home/Timeline.astro';
import Documents from './home/Documents.astro';
import Skills from './home/Skills.astro';
import About from './home/About.astro';
import Contacts from './home/Contacts.astro';
import { getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
---

<Base ogKey="home">
  <Hero lang={lang} />
  <Venues lang={lang} />
  <Stats lang={lang} />
  <Projects lang={lang} />
  <Timeline lang={lang} />
  <Documents lang={lang} />
  <Skills lang={lang} />
  <About lang={lang} />
  <Contacts lang={lang} />
</Base>
