---
import { getProfile } from '../../lib/data';
import { useT, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const p = await getProfile();
const icons: Record<string, string> = {
  telegram: 'M21.5 4.5 2.8 11.7c-1 .4-1 1.8.1 2.1l4.6 1.5 1.8 5.6c.3.9 1.4 1.1 2 .4l2.6-2.6 4.7 3.5c.8.6 1.9.1 2.1-.8L23 5.9c.2-1-.6-1.8-1.5-1.4Zm-3.4 4-8.5 7.6-.4 3.4-1.4-4.6 10.3-6.4Z',
  email: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Zm1.8.3 7.2 5.6 7.2-5.6M4.8 17.4l5.6-5',
  github: 'M12 2.5a9.7 9.7 0 0 0-3.1 18.9c.5.1.7-.2.7-.5v-1.8c-2.7.6-3.3-1.2-3.3-1.2-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.1-.2-4.4-1.1-4.4-4.8 0-1.1.4-1.9 1-2.6-.1-.2-.4-1.2.1-2.6 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.6.6.7 1 1.5 1 2.6 0 3.7-2.3 4.6-4.4 4.8.3.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.7 9.7 0 0 0 12 2.5Z',
  linkedin: 'M4.5 3.5h15a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Zm3 6.5v7.5M7.5 6.8v.1M11 17.5V13a2.5 2.5 0 0 1 5 0v4.5M11 10v7.5',
  instagram: 'M7.5 3.5h9a4 4 0 0 1 4 4v9a4 4 0 0 1-4 4h-9a4 4 0 0 1-4-4v-9a4 4 0 0 1 4-4Zm4.5 5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm5-1.2v.1',
  link: 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1',
};
const filledIcons = new Set(['telegram', 'github']);
---

<section id="contacts" class="relative overflow-hidden py-28 md:py-40" data-section data-section-label={t('nav.contacts')} aria-labelledby="contacts-title">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="grid-bg absolute inset-0 opacity-70"></div>
    <div class="glow-blob left-1/2 top-1/2 h-[36rem] w-[60rem] -translate-x-1/2 -translate-y-1/2" style="--c: var(--glow); --a: 0.4"></div>
    <div class="glow-blob left-1/2 top-[55%] h-[20rem] w-[34rem] -translate-x-1/2" style="--c: var(--accent); --a: 0.12"></div>
  </div>
  <div class="container-x relative text-center">
    <p class="eyebrow mb-6 flex items-center justify-center gap-3" data-reveal>
      <span class="text-[var(--accent)]">07</span><span class="h-px w-8 bg-[var(--line-2)]" aria-hidden="true"></span>{t('contacts.eyebrow')}
    </p>
    <h2 id="contacts-title" class="contact-title" data-split>{t('contacts.title')}</h2>
    <p class="mx-auto mt-6 max-w-xl text-[1.1rem] leading-relaxed text-[var(--text-dim)]" data-reveal>{t('contacts.lead')}</p>
    <ul class="mx-auto mt-12 flex max-w-3xl flex-wrap justify-center gap-3" role="list">
      {
        p.contacts.map((c, i) => {
          const isMail = c.url.startsWith('mailto:');
          return (
            <li data-reveal style={`--d:${i * 0.06}s`} class="flex">
              <a
                href={c.url}
                class:list={['contact-link', c.primary && 'is-primary']}
                target={c.url.startsWith('http') ? '_blank' : undefined}
                rel={c.url.startsWith('http') ? 'noopener' : undefined}
                data-magnetic
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    d={icons[c.kind] ?? icons.link}
                    fill={filledIcons.has(c.kind) ? 'currentColor' : 'none'}
                    stroke={filledIcons.has(c.kind) ? 'none' : 'currentColor'}
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{c.label}</span>
              </a>
              {isMail && (
                <button type="button" class="copy-btn" data-copy={c.url.replace('mailto:', '')} data-copied-label={t('contacts.copied')} aria-label={`${t('contacts.copy')}: ${c.label}`}>
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <rect x="8" y="8" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.7" />
                    <path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" fill="none" stroke="currentColor" stroke-width="1.7" />
                  </svg>
                </button>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .contact-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    max-width: 16ch;
    margin-inline: auto;
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    height: 3.4rem;
    padding-inline: 1.4rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgb(8 9 11 / 0.6);
    backdrop-filter: blur(8px);
    font-weight: 500;
    transition:
      border-color 0.3s,
      background-color 0.3s,
      color 0.3s,
      transform 0.4s var(--ease-out-expo);
  }
  .contact-link:hover {
    border-color: color-mix(in oklab, var(--accent) 60%, transparent);
    color: var(--accent);
  }
  .contact-link.is-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .contact-link.is-primary:hover {
    color: var(--accent-ink);
    box-shadow: 0 14px 50px -10px color-mix(in oklab, var(--accent) 80%, transparent);
  }
  .copy-btn {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    margin-left: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--text-dim);
    background: rgb(8 9 11 / 0.6);
    transition:
      color 0.25s,
      border-color 0.25s;
  }
  .copy-btn:hover {
    color: var(--text);
    border-color: rgb(255 255 255 / 0.3);
  }
</style>
