---
import SectionHead from '../SectionHead.astro';
import { getProfile } from '../../lib/data';
import { loc, useT, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const profile = await getProfile();
const groups = profile.skills;
---

{
  groups.length > 0 && (
    <section id="skills" class="relative py-24 md:py-32" data-section data-section-label={t('nav.skills')} aria-labelledby="skills-title">
      <div class="container-x">
        <SectionHead index="05" eyebrow={t('skills.eyebrow')} title={t('skills.title')} id="skills-title" />
        <div class="skills-grid">
          {groups.map((g, i) => (
            <article class="skill card" data-spot data-reveal style={`--d:${(i % 3) * 0.08}s`}>
              <header class="flex items-baseline justify-between gap-4">
                <h3 class="text-[1.05rem] font-semibold">{loc(g.group, lang)}</h3>
                <span class="font-mono text-[0.7rem] text-[var(--text-mute)]">{String(g.items.length).padStart(2, '0')}</span>
              </header>
              <ul class="mt-5 flex flex-wrap gap-1.5" role="list">
                {g.items.map((s) => (
                  <li class="skill-chip">{s}</li>
                ))}
              </ul>
              {loc(g.evidence, lang) && <p class="mt-5 border-t border-[var(--line)] pt-4 text-[0.8rem] leading-relaxed text-[var(--text-mute)]">{loc(g.evidence, lang)}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .skills-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .skills-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .skill {
    padding: 1.4rem;
    transition: border-color 0.3s;
  }
  .skill:hover {
    border-color: var(--line-2);
  }
  .skill-chip {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding-inline: 0.8rem;
    border-radius: 0.6rem;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.025);
    font-size: 0.84rem;
    color: var(--text);
    transition:
      border-color 0.25s,
      color 0.25s,
      background-color 0.25s;
  }
  .skill-chip:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 7%, transparent);
  }
</style>
