---
import { Picture } from 'astro:assets';
import { getAchievements, getProfile, groupOf } from '../lib/data';
import { dateKey, loc, localizePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const profile = await getProfile();
const name = loc(profile.name, lang);
const [first, ...rest] = name.split(' ');
const last = rest.join(' ');
const phrases = profile.typed[lang];
const photos = profile.heroPhotos.slice(0, 3);
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/hero-poster.webp', { eager: true });
const poster = Object.values(posters)[0]?.default;
// Three strongest documented wins: startups & hackathons first, then newest.
const proof = (await getAchievements())
  .filter((a) => a.data.featured && a.data.podium)
  .sort((a, b) => Number(groupOf(b) === 'startup') - Number(groupOf(a) === 'startup') || dateKey(b.data.date).localeCompare(dateKey(a.data.date)))
  .slice(0, 3);
const cv = `/cv/gennadiy-kozlov-${lang}.pdf`;
---

<section id="top" class="hero" data-section data-section-label={lang === 'ru' ? 'Начало' : 'Top'} aria-labelledby="hero-name">
  <div class="hero-bg" aria-hidden="true">
    {poster && <Picture src={poster} formats={['avif', 'webp']} widths={[960, 1920]} sizes="100vw" alt="" class="hero-poster" loading="eager" fetchpriority="low" />}
    <canvas class="hero-canvas" data-hero-gl></canvas>
    <div class="grid-bg absolute inset-0 opacity-50"></div>
    <div class="glow-blob left-[-14rem] top-[-14rem] h-[44rem] w-[44rem] !opacity-30" style="--c: var(--glow)"></div>
    <div class="glow-blob bottom-[-18rem] right-[-10rem] h-[38rem] w-[38rem] !opacity-[0.08]" style="--c: var(--accent)"></div>
    <div class="hero-fade"></div>
  </div>

  <div class="container-x relative z-10 grid min-h-[100svh] items-center gap-12 pb-20 pt-[calc(var(--nav-h)+3rem)] lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)] lg:pb-16">
    <div class="hero-copy">
      <p class="eyebrow flex items-center gap-3" data-hero-in>
        <span class="live-dot" aria-hidden="true"></span>
        {loc(profile.location, lang)}
      </p>

      <h1 id="hero-name" class="hero-name" data-hero-name>
        <span class="block">{first}</span>
        <span class="block text-gradient">{last}</span>
      </h1>

      <p class="typed-line" data-hero-in>
        <span class="text-[var(--accent)]" aria-hidden="true">›</span>
        <span class="sr-only">{phrases.join('; ')}</span>
        <span aria-hidden="true" data-typed={JSON.stringify(phrases)}>{phrases[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>

      <p class="hero-intro" data-hero-in>{loc(profile.intro, lang)}</p>

      <div class="mt-9 flex flex-wrap gap-3" data-hero-in>
        <a href={`${localizePath('/', lang)}#projects`} class="btn btn-primary" data-magnetic>
          {t('hero.cta.projects')}
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a href={cv} class="btn btn-ghost" download data-magnetic>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {t('hero.cta.resume')}
        </a>
      </div>

      {
        proof.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2" data-hero-in aria-label={lang === 'ru' ? 'Ключевые результаты' : 'Key results'}>
            {proof.map((a) => (
              <li>
                <a href={`${localizePath('/', lang)}#a-${a.id}`} class="proof-chip">
                  <span class="proof-dot" aria-hidden="true" />
                  <span class="text-[var(--text)]">{loc(a.data.result, lang)}</span>
                  <span class="truncate">{loc(a.data.venue, lang) || loc(a.data.event, lang) || loc(a.data.title, lang)}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      photos.length > 0 && (
        <div class="hero-photos" data-photos={photos.length} data-tilt="soft">
          {photos.map((p, i) => (
            <figure class="hero-photo" style={`--i:${i}`} data-hero-photo>
              <Picture
                src={p.src}
                formats={['avif', 'webp']}
                widths={[280, 420, 640]}
                sizes="(min-width: 1024px) 19vw, 42vw"
                alt={loc(p.alt, lang)}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                class="h-full w-full object-cover"
              />
              <span class="hero-photo-shine" aria-hidden="true" />
            </figure>
          ))}
        </div>
      )
    }
  </div>

  <a href={`${localizePath('/', lang)}#numbers`} class="scroll-cue" aria-label={t('hero.scroll')}>
    <span class="font-mono text-[0.68rem] uppercase tracking-[0.2em]">{t('hero.scroll')}</span>
    <span class="scroll-cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-poster,
  .hero-poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out-expo);
  }
  :global(html.gl-on) .hero-canvas {
    opacity: 1;
  }
  :global(html.gl-on) .hero-poster {
    opacity: 0;
    transition: opacity 1.2s;
  }
  .hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }
  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 99px;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .hero-name {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.15rem, 9.6vw, 8.6rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    margin-left: -0.04em;
  }
  .typed-line {
    margin-top: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 1.6em;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.7vw, 1.3rem);
    color: var(--text);
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: -0.3rem;
    background: var(--accent);
    box-shadow: 0 0 12px color-mix(in oklab, var(--accent) 70%, transparent);
    animation: blink 1.05s steps(1) infinite;
    transform: translateY(0.05em);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .hero-intro {
    margin-top: 1.25rem;
    max-width: 38rem;
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.6;
    color: var(--text-dim);
  }
  .proof-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 22rem;
    height: 2.1rem;
    padding-inline: 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.025);
    font-size: 0.8rem;
    color: var(--text-dim);
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }
  .proof-chip:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 6%, transparent);
  }
  .proof-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 99px;
    background: var(--accent);
    flex: none;
  }

  /* Photo stack: fanned cards on desktop, a row on phones */
  .hero-photos {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .hero-photo {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 1.1rem;
    border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.9);
  }
  .hero-photo-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.14), transparent 35%);
    mix-blend-mode: overlay;
  }
  @media (min-width: 1024px) {
    .hero-photos {
      display: block;
      height: min(68svh, 40rem);
    }
    .hero-photo {
      position: absolute;
      width: 62%;
      transition:
        transform 0.9s var(--ease-out-expo),
        box-shadow 0.6s;
    }
    .hero-photo:nth-child(1) {
      right: 4%;
      top: 4%;
      z-index: 3;
      transform: rotate(3deg);
    }
    .hero-photo:nth-child(2) {
      left: 0;
      top: 22%;
      z-index: 2;
      transform: rotate(-7deg);
    }
    .hero-photo:nth-child(3) {
      right: 0;
      bottom: 0;
      width: 48%;
      z-index: 1;
      transform: rotate(9deg) translateX(10%);
    }
    .hero-photos[data-photos='1'] .hero-photo {
      width: 82%;
    }
    .hero-photos:hover .hero-photo:nth-child(1) {
      transform: rotate(1deg) translate(4%, -4%);
    }
    .hero-photos:hover .hero-photo:nth-child(2) {
      transform: rotate(-10deg) translate(-8%, 2%);
    }
    .hero-photos:hover .hero-photo:nth-child(3) {
      transform: rotate(13deg) translate(18%, 4%);
    }
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    z-index: 10;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    transform: translateX(-50%);
    color: var(--text-mute);
  }
  @media (min-width: 1024px) and (min-height: 760px) {
    .scroll-cue {
      display: flex;
    }
  }
  .scroll-cue-line {
    position: relative;
    width: 1px;
    height: 3rem;
    overflow: hidden;
    background: var(--line);
  }
  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, var(--accent));
    animation: drip 2.2s var(--ease-in-out-quart) infinite;
  }
  @keyframes drip {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100%);
    }
  }
</style>
