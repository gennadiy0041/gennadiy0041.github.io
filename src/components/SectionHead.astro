---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
}
const { index, eyebrow, title, lead, id } = Astro.props;
---

<header class="mb-12 grid gap-6 md:mb-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end">
  <div>
    <p class="eyebrow mb-5 flex items-center gap-3" data-reveal>
      <span class="text-[var(--accent)]">{index}</span>
      <span class="h-px w-8 bg-[var(--line-2)]" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h2 id={id} class="section-title" data-split>{title}</h2>
  </div>
  {lead && <p class="max-w-md text-[1.02rem] leading-relaxed text-[var(--text-dim)] lg:justify-self-end" data-reveal style="--d:.1s">{lead}</p>}
  <slot />
</header>
