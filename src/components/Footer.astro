---
import { getProfile } from '../lib/data';
import { fmtDate, loc, localizePath, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const profile = await getProfile();
// the site is rebuilt on every content change, so the build date is the "updated" date
const updated = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
---

<footer class="relative mt-32 overflow-hidden border-t border-[var(--line)]">
  <div class="container-x relative py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow mb-4">{loc(profile.location, lang)}</p>
        <a href={localizePath('/', lang)} class="footer-name">
          <span class="sr-only">{loc(profile.name, lang)}</span>
          <span aria-hidden="true">{loc(profile.name, lang)}</span>
        </a>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-[var(--text-dim)]">
        {
          profile.contacts.map((c) => (
            <li>
              <a href={c.url} class="link-underline hover:text-[var(--text)]" target={c.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-[var(--line)] pt-6 font-mono text-[0.72rem] text-[var(--text-mute)] sm:flex-row sm:justify-between">
      <span>© {year} · {t('footer.built')}</span>
      <span>{t('footer.updated')}: {fmtDate(updated, lang)}</span>
    </div>
  </div>
</footer>

<style>
  .footer-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0.04));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: opacity 0.6s var(--ease-out-expo);
  }
  .footer-name:hover {
    background: linear-gradient(180deg, #fff, rgb(255 255 255 / 0.5));
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
